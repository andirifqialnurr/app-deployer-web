DATABASE_URL="postgresql://user:password@host:5432/app_deployer"
DATABASE_URL_DOCKER="postgresql://user:password@postgres:5432/app_deployer"
APP_BASE_URL="https://deploy.example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"

STORAGE_PROVIDER="r2"
