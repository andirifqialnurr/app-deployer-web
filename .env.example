POSTGRES_DB="app_deployer"
POSTGRES_USER="app_deployer"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
DATABASE_URL="postgresql://app_deployer:replace-with-a-strong-database-password@127.0.0.1:5432/app_deployer"
DATABASE_URL_DOCKER="postgresql://app_deployer:replace-with-a-strong-database-password@postgres:5432/app_deployer"
APP_BASE_URL="https://deploy.example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"

STORAGE_PROVIDER="r2"
S3_ENDPOINT="https://accountid.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="app-deployer"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_PUBLIC_BASE_URL="https://cdn.example.com"
